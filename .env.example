# ─────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────
# META (covers Instagram, Facebook, Threads)
# One long-lived token per avatar account
# ─────────────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Avatar 1
META_LONG_LIVED_TOKEN_1=your-long-lived-token-avatar-1
INSTAGRAM_ACCOUNT_ID_1=your-ig-account-id-avatar-1
FACEBOOK_PAGE_ID_1=your-fb-page-id-avatar-1
THREADS_ACCOUNT_ID_1=your-threads-account-id-avatar-1

# Avatar 2
META_LONG_LIVED_TOKEN_2=your-long-lived-token-avatar-2
INSTAGRAM_ACCOUNT_ID_2=your-ig-account-id-avatar-2
FACEBOOK_PAGE_ID_2=your-fb-page-id-avatar-2
THREADS_ACCOUNT_ID_2=your-threads-account-id-avatar-2

# Avatar 3
META_LONG_LIVED_TOKEN_3=your-long-lived-token-avatar-3
INSTAGRAM_ACCOUNT_ID_3=your-ig-account-id-avatar-3
FACEBOOK_PAGE_ID_3=your-fb-page-id-avatar-3
THREADS_ACCOUNT_ID_3=your-threads-account-id-avatar-3

# ─────────────────────────────────────────
# YOUTUBE (YouTube Data API v3)
# ─────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key

YOUTUBE_CHANNEL_ID_1=your-yt-channel-id-avatar-1
YOUTUBE_CHANNEL_ID_2=your-yt-channel-id-avatar-2
YOUTUBE_CHANNEL_ID_3=your-yt-channel-id-avatar-3

# ─────────────────────────────────────────
# TIKTOK (requires TikTok Business API approval)
# Leave blank until your developer app is approved
# ─────────────────────────────────────────
TIKTOK_ACCESS_TOKEN_1=
TIKTOK_ACCESS_TOKEN_2=
TIKTOK_ACCESS_TOKEN_3=
TIKTOK_OPEN_ID_1=
TIKTOK_OPEN_ID_2=
TIKTOK_OPEN_ID_3=

# ─────────────────────────────────────────
# AVATAR DISPLAY NAMES
# ─────────────────────────────────────────
NEXT_PUBLIC_AVATAR_1_NAME=Avatar 1
NEXT_PUBLIC_AVATAR_2_NAME=Avatar 2
NEXT_PUBLIC_AVATAR_3_NAME=Avatar 3

# ─────────────────────────────────────────
# SECURITY
# Generate a random string: openssl rand -hex 32
# ─────────────────────────────────────────
CRON_SECRET=your-random-cron-secret-here
